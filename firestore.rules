rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Profiles ---
    match /profiles/{userId} {
      allow read: if true;                              // Public profiles
      allow write: if request.auth != null
                   && request.auth.uid == userId;       // Owner only
    }

    // --- Top4 Entries ---
    // Document IDs are "{userId}_{category}"
    match /top4_entries/{entryId} {
      allow read: if true;                              // Feed is public
      allow create: if request.auth != null
                    && request.resource.data.user_id == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.user_id == request.auth.uid
                        // Allow like_count increments from any authed user
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['like_count']));
      allow delete: if request.auth != null
                    && resource.data.user_id == request.auth.uid;
    }

    // --- Likes ---
    // Document IDs are "{likedByUserId}_{entryId}"
    match /likes/{likeId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.liked_by == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.liked_by == request.auth.uid;
    }

    // --- Notifications ---
    match /notifications/{userId}/items/{notifId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;        // Only owner reads
      allow create: if request.auth != null;            // Any authed user can notify
      allow update: if request.auth != null
                    && request.auth.uid == userId;      // Owner marks read
    }
  }
}
